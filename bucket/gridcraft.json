{
    "version": "0.16.1",
    "description": "Open-source spreadsheets and data analysis in pure Rust: styled tables, conditional formatting, sparklines and charts",
    "homepage": "https://github.com/storytold/gridcraft",
    "license": "MIT OR Apache-2.0",
    "notes": [
        "GridCraft keeps its settings in %APPDATA%\\GridCraft, which is outside the Scoop install directory: they survive 'scoop update' and are not touched by 'scoop uninstall'.",
        "This build offers no portable marker and no config-directory environment variable, so that folder cannot be moved into Scoop's persist store.",
        "'gridcraft-cli.exe' is exposed as the 'gridcraft-cli' shim.",
        "The portable zip does not register the file associations that the MSI installer adds.",
        "The app has no built-in updater; use 'scoop update gridcraft' so the install and this manifest stay in sync."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/storytold/gridcraft/releases/download/v0.16.1/gridcraft-0.16.1-windows-x64-portable.zip",
            "hash": "c39b87a7afef9d67c96979aab271732d5e095caa3da4f247fe5d71aaa7daba4a",
            "installer": {
                "script": [
                    "$stage = \"$dir\\gridcraft-$version-windows-x64-portable\"",
                    "Move-Item \"$stage\\*\" $dir -ErrorAction Stop",
                    "Remove-Item $stage -ErrorAction Stop"
                ]
            }
        },
        "arm64": {
            "url": "https://github.com/storytold/gridcraft/releases/download/v0.16.1/gridcraft-0.16.1-windows-arm64-portable.zip",
            "hash": "963e1c923fd9a9cd54fa3f571ce9cd2dbddbc10da0a268fdec08bb70f887ce91",
            "installer": {
                "script": [
                    "$stage = \"$dir\\gridcraft-$version-windows-arm64-portable\"",
                    "Move-Item \"$stage\\*\" $dir -ErrorAction Stop",
                    "Remove-Item $stage -ErrorAction Stop"
                ]
            }
        }
    },
    "bin": "gridcraft-cli.exe",
    "shortcuts": [
        [
            "gridcraft.exe",
            "GridCraft"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/storytold/gridcraft/releases/download/v$version/gridcraft-$version-windows-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/storytold/gridcraft/releases/download/v$version/gridcraft-$version-windows-arm64-portable.zip"
            }
        }
    }
}
