{
    "version": "0.15.2",
    "description": "Open-source word processing rebuilt in pure Rust: ribbon interface, styles gallery, navigation pane and threaded documents",
    "homepage": "https://github.com/storytold/wordcraft",
    "license": "MIT OR Apache-2.0",
    "notes": [
        "WordCraft keeps its settings in %APPDATA%\\WordCraft, which is outside the Scoop install directory: they survive 'scoop update' and are not touched by 'scoop uninstall'.",
        "This build offers no portable marker and no config-directory environment variable, so that folder cannot be moved into Scoop's persist store.",
        "'wordcraft-cli.exe' is exposed as the 'wordcraft-cli' shim.",
        "The portable zip does not register the file associations that the MSI installer adds.",
        "The app has no built-in updater; use 'scoop update wordcraft' so the install and this manifest stay in sync."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/storytold/wordcraft/releases/download/v0.15.2/wordcraft-0.15.2-windows-x64-portable.zip",
            "hash": "ddd5c868d927e7ee6621fd0325486963a3ea3a5b5ce46ddae7e70d7a1ff5124d",
            "installer": {
                "script": [
                    "$stage = \"$dir\\wordcraft-$version-windows-x64-portable\"",
                    "Move-Item \"$stage\\*\" $dir -ErrorAction Stop",
                    "Remove-Item $stage -ErrorAction Stop"
                ]
            }
        },
        "arm64": {
            "url": "https://github.com/storytold/wordcraft/releases/download/v0.15.2/wordcraft-0.15.2-windows-arm64-portable.zip",
            "hash": "bedba4677a9e128c2e041ddebe44d2c236b2bfa29a1f683136e6104cc0e2d08c",
            "installer": {
                "script": [
                    "$stage = \"$dir\\wordcraft-$version-windows-arm64-portable\"",
                    "Move-Item \"$stage\\*\" $dir -ErrorAction Stop",
                    "Remove-Item $stage -ErrorAction Stop"
                ]
            }
        }
    },
    "bin": "wordcraft-cli.exe",
    "shortcuts": [
        [
            "wordcraft.exe",
            "WordCraft"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/storytold/wordcraft/releases/download/v$version/wordcraft-$version-windows-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/storytold/wordcraft/releases/download/v$version/wordcraft-$version-windows-arm64-portable.zip"
            }
        }
    }
}
