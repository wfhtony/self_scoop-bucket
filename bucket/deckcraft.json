{
    "version": "0.15.1",
    "description": "Open-source presentation and slide-show editor in pure Rust: ribbon interface, slide thumbnails, speaker notes and vector diagrams",
    "homepage": "https://github.com/storytold/deckcraft",
    "license": "MIT OR Apache-2.0",
    "notes": [
        "DeckCraft keeps its settings in %APPDATA%\\DeckCraft, which is outside the Scoop install directory: they survive 'scoop update' and are not touched by 'scoop uninstall'.",
        "This build offers no portable marker and no config-directory environment variable, so that folder cannot be moved into Scoop's persist store.",
        "'deckcraft-cli.exe' is exposed as the 'deckcraft-cli' shim.",
        "The portable zip does not register the file associations that the MSI installer adds.",
        "The app has no built-in updater; use 'scoop update deckcraft' so the install and this manifest stay in sync."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/storytold/deckcraft/releases/download/v0.15.1/deckcraft-0.15.1-windows-x64-portable.zip",
            "hash": "2e43aa283245485a4102f8de6610e98fa36e5f4c71c3a0ea018ee5fe2aeab8e8",
            "installer": {
                "script": [
                    "$stage = \"$dir\\deckcraft-$version-windows-x64-portable\"",
                    "Move-Item \"$stage\\*\" $dir -ErrorAction Stop",
                    "Remove-Item $stage -ErrorAction Stop"
                ]
            }
        },
        "arm64": {
            "url": "https://github.com/storytold/deckcraft/releases/download/v0.15.1/deckcraft-0.15.1-windows-arm64-portable.zip",
            "hash": "ff194a3deb1915fc1eb9794bf561964539f2d091d56b41c556bb39ae3f5ba86e",
            "installer": {
                "script": [
                    "$stage = \"$dir\\deckcraft-$version-windows-arm64-portable\"",
                    "Move-Item \"$stage\\*\" $dir -ErrorAction Stop",
                    "Remove-Item $stage -ErrorAction Stop"
                ]
            }
        }
    },
    "bin": "deckcraft-cli.exe",
    "shortcuts": [
        [
            "deckcraft.exe",
            "DeckCraft"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/storytold/deckcraft/releases/download/v$version/deckcraft-$version-windows-x64-portable.zip"
            },
            "arm64": {
                "url": "https://github.com/storytold/deckcraft/releases/download/v$version/deckcraft-$version-windows-arm64-portable.zip"
            }
        }
    }
}
